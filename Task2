<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <title>Düymələr</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <div class="duyme">
        <button class="duyme normal">Normal</button>
        <button class="duyme outline">Outline</button>
        <button class="duyme ugur">Uğur</button>
        <button class="duyme tehluke">Təhlükə</button>
    </div>

</body>
</html>

CSS;
.duyme {
    display: flex;
    gap: 10px;
    padding: 50px;
    border-radius: 5px;
    border: none;
    font-size: 14px;
    cursor: pointer;
    font-weight: bold;
}

.normal {
    background-color: aqua;
    color: white;
}
.outline {
    background-color: white;
    border: 2px solid blue;
    color: aqua;
}
.ugur {
    background-color: green;
    color: white;
}

.tehluke {
    background-color: red;
    color: white;
}
